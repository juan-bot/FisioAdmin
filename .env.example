# Firebase web config (copiado desde la consola de Firebase: Project settings > General > Your apps)
# En producción estas variables se inyectan desde los GitHub Secrets en el workflow de CI.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
