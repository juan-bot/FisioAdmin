rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsRecord() {
      return resource.data.therapistId == request.auth.uid;
    }

    function createsOwnRecord() {
      return request.resource.data.therapistId == request.auth.uid;
    }

    match /patients/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if signedIn() && (isAdmin() || createsOwnRecord());
      allow update: if isAdmin() || (ownsRecord() && createsOwnRecord());
      allow delete: if isAdmin() || ownsRecord();
    }

    match /appointments/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if signedIn() && (isAdmin() || createsOwnRecord());
      allow update: if isAdmin() || (ownsRecord() && createsOwnRecord());
      allow delete: if isAdmin() || ownsRecord();
    }

    match /prescriptions/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if signedIn() && (isAdmin() || createsOwnRecord());
      allow update: if isAdmin() || (ownsRecord() && createsOwnRecord());
      allow delete: if isAdmin() || ownsRecord();
    }

    match /progressRecords/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if signedIn() && (isAdmin() || createsOwnRecord());
      allow update: if isAdmin() || (ownsRecord() && createsOwnRecord());
      allow delete: if isAdmin() || ownsRecord();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && userId == request.auth.uid);
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.role == 'pending'
        && request.resource.data.approved == false
        && request.resource.data.disabled == false;
      allow update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read, write: if isAdmin();
    }
  }
}
